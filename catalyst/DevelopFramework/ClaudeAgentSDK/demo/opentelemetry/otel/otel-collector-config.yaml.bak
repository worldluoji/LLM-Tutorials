receivers:
  otlp:
    protocols:
      http:
        endpoint: "0.0.0.0:4318"
      grpc:
        endpoint: "0.0.0.0:4317" # 补充 gRPC 接收器，兼容性更好

exporters:
  # 使用 otlp 协议将 Traces 发送给 Jaeger
  otlp/jaeger: 
    endpoint: "jaeger:4317" # Jaeger 原生支持 OTLP gRPC 协议
    tls:
      insecure: true
  
  # 导出 Metrics 给 Prometheus 拉取
  prometheus:
    endpoint: "0.0.0.0:8889"
    namespace: "claude_agent"

processors:
  batch: {}

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlp/jaeger] # 修改这里，使用新的 otlp/jaeger 导出器
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [prometheus]
