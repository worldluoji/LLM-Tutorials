{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(*.vue)",
      "Read(*.js)",
      "Read(*.ts)",
      "Read(*.html)",
      "Read(*.css)",
      "Read(package.json)",
      "Read(README.md)",
      "Read(constitution.md)",
      "Read(specs/**)",
      "Grep",
      "Glob",
      "LS",
      "Bash(pnpm:*)"
    ],
    "ask": [
      "Write",
      "Edit",
      "MultiEdit",
      "Bash(pnpm:add:*)",
      "Bash(pnpm:intall)",
      "Bash(git:add:*)",
      "Bash(git:commit:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Bash(rm:*)",
      "Bash(git:push:*)",
      "WebFetch"
    ]
  }
}
